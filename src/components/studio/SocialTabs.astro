---
const profiles = [
 { name:'Facebook', id:'facebook', icon:'/brand/facebook-icon.svg', url:'https://www.facebook.com/profile.php?id=61561070733012', detail:'Zobacz aktualności i realizacje KALTRUCK na Facebooku.' },
 { name:'Instagram', id:'instagram', icon:'/brand/instagram-icon.svg', url:'https://www.instagram.com/transporthdsplock/', detail:'Zobacz zdjęcia realizacji KALTRUCK na Instagramie.' }
];
---
{profiles.map(p => (
 <div class:list={['studio-social-tab','studio-social-tab--' + p.id]} data-studio-tool={p.id}>
  <button type="button" class="studio-social-tab__toggle" data-studio-tool-toggle aria-controls={'studio-social-panel-' + p.id} aria-expanded="false" aria-label={'Pokaż profil ' + p.name}>
   <img src={p.icon} alt="" aria-hidden="true" width="24" height="24" />
   <strong>{p.name.toUpperCase()}</strong>
  </button>
  <div class="studio-social-tab__panel" id={'studio-social-panel-' + p.id} data-studio-tool-panel aria-hidden="true" inert>
   <img src={p.icon} class="studio-social-tab__icon" alt="" aria-hidden="true" width="44" height="44" />
   <div class="studio-social-tab__info">
    <p>{p.name}</p>
    <span>{p.detail}</span>
    <a href={p.url} target="_blank" rel="noopener noreferrer">Otwórz profil ↗</a>
   </div>
  </div>
 </div>
))}
<style>
 .studio-social-tab{--handle:48px;position:absolute;right:0;z-index:16;display:grid;grid-template-columns:var(--handle) minmax(0,1fr);width:min(365px,calc(100vw - 20px));align-items:center;transform:translate(calc(100% - var(--handle)),-50%);transition:transform .35s cubic-bezier(.22,.78,.18,1);filter:drop-shadow(0 12px 25px rgba(4,20,15,.19));}
 .studio-social-tab--facebook{top:calc(50% + 151px);}
 .studio-social-tab--instagram{top:calc(50% + 256px);}
 .studio-social-tab.is-open{transform:translate(0,-50%);z-index:19;}
 .studio-social-tab__toggle{border:1px solid rgba(200,239,114,.65);border-right:0;background:#faf9f3;color:#1e3828;border-radius:12px 0 0 12px;height:91px;width:var(--handle);padding:9px 5px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;cursor:pointer;}
 .studio-social-tab__toggle img{display:block;width:22px;height:22px;object-fit:contain;}
 .studio-social-tab__toggle strong{font-size:9px;letter-spacing:.09em;font-weight:850;writing-mode:vertical-rl;transform:rotate(180deg);}
 .studio-social-tab__toggle:hover,.studio-social-tab.is-open .studio-social-tab__toggle{background:#e7f6cc;}
 .studio-social-tab__panel{display:flex;gap:16px;align-items:center;padding:20px;min-height:170px;color:#183020;background:#faf9f3;border:1px solid #c7d8bf;border-right:0;border-radius:12px 0 0 12px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s ease,visibility .2s ease;}
 .studio-social-tab.is-open .studio-social-tab__panel{opacity:1;visibility:visible;pointer-events:auto;}
 .studio-social-tab__icon{display:block;width:42px;height:42px;align-self:flex-start;flex:0 0 42px;}
 .studio-social-tab__info{min-width:0;}
 .studio-social-tab__info p{font:800 19px/1.2 'Manrope',Arial,sans-serif;margin:0 0 8px;}
 .studio-social-tab__info>span{display:block;font-size:13px;line-height:1.55;color:#536753;}
 .studio-social-tab__info a{display:inline-flex;align-items:center;margin-top:12px;font-size:13px;color:#436f2f;font-weight:850;border-bottom:1px solid #a9c79b;padding-bottom:4px;}
 .studio-social-tab__toggle:focus-visible,.studio-social-tab__info a:focus-visible{outline:3px solid #c8ef72;outline-offset:2px;}
 @media(max-width:700px){.studio-social-tab{--handle:38px;width:min(320px,calc(100vw - 12px));}.studio-social-tab--facebook{top:calc(55% + 115px);}.studio-social-tab--instagram{top:calc(55% + 198px);}.studio-social-tab__toggle{height:72px;gap:5px;}.studio-social-tab__toggle img{width:19px;height:19px;}.studio-social-tab__toggle strong{font-size:7px;}.studio-social-tab__panel{padding:16px;min-height:143px;}}
 @media(prefers-reduced-motion:reduce){.studio-social-tab,.studio-social-tab__panel{transition:none;}}
</style>