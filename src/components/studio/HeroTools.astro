---
import DistanceEstimator from './DistanceEstimator.astro';
import GoogleReviews from './GoogleReviews.astro';
import GoogleMapsPin from './GoogleMapsPin.astro';
---
<div class="studio-hero-tool studio-hero-tool--route" data-studio-tool="route">
  <div class="studio-hero-tool__panel" id="studio-route-panel" data-studio-tool-panel aria-hidden="true" inert>
    <div class="studio-hero-tool__sheet-heading"><span>TRASA / GOOGLE MAPS</span><button type="button" class="studio-hero-tool__close" data-studio-panel-close aria-label="Zamknij planowanie trasy">✕</button></div>
    <DistanceEstimator instanceId="studio-hero-route" variant="drawer" deferMap={true} />
  </div>
  <button type="button" class="studio-hero-tool__toggle" data-studio-tool-toggle aria-expanded="false" aria-controls="studio-route-panel" aria-label="Otwórz planowanie trasy w Google Maps"><GoogleMapsPin class="studio-hero-tool__pin" /><strong>TRASA</strong></button>
</div>
<div class="studio-hero-tool studio-hero-tool--reviews" data-studio-tool="reviews">
  <button type="button" class="studio-hero-tool__toggle" data-studio-tool-toggle aria-expanded="false" aria-controls="studio-reviews-panel" aria-label="Pokaż opinie Google"><span class="studio-hero-tool__star" aria-hidden="true">★</span><strong>OPINIE</strong></button>
  <div class="studio-hero-tool__panel" id="studio-reviews-panel" data-studio-tool-panel aria-hidden="true" inert>
    <div class="studio-hero-tool__sheet-heading"><span>OPINIE KLIENTÓW</span><button type="button" class="studio-hero-tool__close" data-studio-panel-close aria-label="Zamknij opinie Google">✕</button></div>
    <GoogleReviews />
  </div>
</div>
<script is:inline>
  (() => {
    const tools = Array.from(document.querySelectorAll('[data-studio-tool]')).filter(node => node instanceof HTMLElement);
    const setOpen = (tool, open) => {
      const toggle = tool.querySelector('[data-studio-tool-toggle]');
      const panel = tool.querySelector('[data-studio-tool-panel]');
      if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
      tool.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      panel.toggleAttribute('inert', !open);
      if (open) {
        if (tool.dataset.studioTool === 'route') {
          panel.querySelector('[data-google-route]')?.dispatchEvent(new CustomEvent('kaltruck:route-activate'));
        } else if (tool.dataset.studioTool === 'reviews') {
          panel.querySelector('[data-google-reviews]')?.dispatchEvent(new CustomEvent('kaltruck:reviews-activate'));
        }
      }
    };
    const mobileLayout = window.matchMedia('(max-width:800px)');
    const homeHero = document.querySelector('.home-hero');
    const syncToolContainers = () => {
      if (!homeHero) return;
      tools.forEach(tool => {
        const target = mobileLayout.matches ? document.body : homeHero;
        if (tool.parentElement !== target) target.appendChild(tool);
      });
    };
    syncToolContainers();
    mobileLayout.addEventListener('change', syncToolContainers);
    const openTool = (name) => {
      const selected = tools.find(tool => tool.dataset.studioTool === name);
      if (!selected) return false;
      tools.forEach(other => setOpen(other, other === selected));
      return true;
    };
    tools.forEach(tool => {
      const toggle = tool.querySelector('[data-studio-tool-toggle]');
      toggle?.addEventListener('click', () => {
        const opening = !tool.classList.contains('is-open');
        tools.forEach(other => setOpen(other, other === tool && opening));
      });
      tool.querySelector('[data-studio-panel-close]')?.addEventListener('click', () => setOpen(tool, false));
    });
    document.querySelectorAll('[data-studio-mobile-panel]').forEach(link => {
      link.addEventListener('click', event => {
        const panel = link.getAttribute('data-studio-mobile-panel');
        if (panel && openTool(panel)) event.preventDefault();
      });
    });
    const openFromQuery = () => {
      const panel = new URLSearchParams(window.location.search).get('panel');
      if (panel === 'route' || panel === 'reviews') openTool(panel);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', openFromQuery, { once: true });
    else openFromQuery();
    document.addEventListener('pointerdown', event => {
      if (!(event.target instanceof Node)) return;
      tools.forEach(tool => { if (tool.classList.contains('is-open') && !tool.contains(event.target)) setOpen(tool, false); });
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') tools.forEach(tool => setOpen(tool, false));
    });
  })();
</script>
<style>
  .studio-hero-tool { --handle:55px; position:absolute; top:50%; width:min(725px,calc(100vw - 28px)); z-index:15; display:grid; align-items:center; filter:drop-shadow(0 15px 35px rgba(0,0,0,.24)); transition:transform .35s cubic-bezier(.22,.78,.18,1); }
  .studio-hero-tool--route { left:0; grid-template-columns:minmax(0,1fr) var(--handle); transform:translate(calc(-100% + var(--handle)),-50%); }
  .studio-hero-tool--reviews { right:0; width:min(685px,calc(100vw - 28px)); grid-template-columns:var(--handle) minmax(0,1fr); transform:translate(calc(100% - var(--handle)),-50%); }
  .studio-hero-tool.is-open {transform:translate(0,-50%);}
  .studio-hero-tool__toggle { width:var(--handle); height:112px; border:1px solid rgba(200,239,114,.65); background:rgba(248,249,243,.97); color:#213b2a; cursor:pointer; display:flex; flex-direction:column; align-items:center; justify-content:space-between; gap:0; padding:14px 6px; }
  .studio-hero-tool--route .studio-hero-tool__toggle {border-radius:0 13px 13px 0;border-left:0;}
  .studio-hero-tool--reviews .studio-hero-tool__toggle {border-radius:13px 0 0 13px;border-right:0;}
  .studio-hero-tool__toggle span {font-size:24px;line-height:1;color:#4f7e34;}
  .studio-hero-tool--reviews .studio-hero-tool__star{color:#4f7e34;transition:color .2s ease,transform .2s ease;}
  .studio-hero-tool--reviews.is-open .studio-hero-tool__star{color:#e1aa2f;transform:scale(1.12);}
  .studio-hero-tool--reviews .studio-hero-tool__toggle[aria-expanded="true"] .studio-hero-tool__star{color:#e1aa2f;}
  :global(.studio-hero-tool__pin){display:block;width:20px;height:24px;object-fit:contain;transform:rotate(-90deg);filter:drop-shadow(0 1px 2px rgba(0,0,0,.12));}
  .studio-hero-tool__toggle strong {writing-mode:vertical-rl;transform:rotate(180deg);font-size:10px;letter-spacing:.14em;line-height:1;}
  .studio-hero-tool__toggle:hover,.studio-hero-tool__toggle[aria-expanded=true] {background:#e4f4c1;}
  .studio-hero-tool__panel {background:#faf9f3;color:#16291d;max-height:min(78svh,690px);overflow:auto;pointer-events:none;visibility:hidden;opacity:0;transition:opacity .2s,visibility .2s;border:1px solid #b6c8ae;}
  .studio-hero-tool--route .studio-hero-tool__panel {border-radius:0 14px 14px 0;border-left:0;}
  .studio-hero-tool--reviews .studio-hero-tool__panel {border-radius:14px 0 0 14px;border-right:0;}
  .studio-hero-tool.is-open .studio-hero-tool__panel {visibility:visible;pointer-events:auto;opacity:1;}
  .studio-hero-tool__sheet-heading{display:none;}
  @media(max-width:800px){
    .studio-hero-tool,.studio-hero-tool--route,.studio-hero-tool--reviews{
      position:fixed;left:0;right:0;top:auto;bottom:0;
      width:100%;max-width:none;display:block;z-index:120;
      transform:translateY(110%);filter:drop-shadow(0 -12px 32px rgba(4,20,15,.30));
      transition:transform .28s ease;
    }
    .studio-hero-tool.is-open{transform:translateY(0);}
    .studio-hero-tool__toggle{display:none;}
    .studio-hero-tool__panel,.studio-hero-tool--route .studio-hero-tool__panel,.studio-hero-tool--reviews .studio-hero-tool__panel{
      max-height:min(79dvh,680px);overflow-y:auto;overscroll-behavior:contain;
      border-radius:18px 18px 0 0;border:1px solid #c2d4bc;
      background:#faf9f3;
    }
    .studio-hero-tool__sheet-heading{
      display:flex;align-items:center;justify-content:space-between;
      position:sticky;top:0;z-index:5;
      padding:12px 16px;background:#f0f4e8;border-bottom:1px solid #d7e3d1;
      color:#33552b;font-size:11px;font-weight:800;letter-spacing:.13em;
    }
    .studio-hero-tool__close{
      min-width:38px;min-height:38px;border:1px solid #c7d6c0;
      border-radius:10px;background:#fff;color:#183020;font-size:18px;
    }
  }
  @media(prefers-reduced-motion:reduce){.studio-hero-tool,.studio-hero-tool__panel{transition:none}}
</style>
