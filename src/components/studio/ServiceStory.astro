---
interface Props {
  eyebrow: string; title: string; highlight: string; text: string; href: string;
  image: string; alt: string; reverse?: boolean; width?: number; height?: number;
}
const { eyebrow, title, highlight, text, href, image, alt, reverse = false, width = 1440, height = 1080 } = Astro.props;
const highlightAt = title.indexOf(highlight);
const hasHighlight = highlight.length > 0 && highlightAt >= 0;
const beforeHighlight = hasHighlight ? title.slice(0, highlightAt) : title;
const afterHighlight = hasHighlight ? title.slice(highlightAt + highlight.length) : '';
---
<section class:list={['ps-story', {'ps-story--reverse': reverse}]} aria-label={title}>
  <div class="container ps-story__grid">
    <div class="ps-story__media">
      <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      <span class="ps-story__photo-label">KALTRUCK / REALIZACJE</span>
    </div>
    <div class="ps-story__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{beforeHighlight}{hasHighlight && <span class="ps-story__highlight">{highlight}</span>}{afterHighlight}</h2>
      <p class="ps-story__description">{text}</p>
      <a class="ps-story__link" href={href}>Poznaj usługę <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
