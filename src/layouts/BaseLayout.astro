---
import { site, services } from '../data/site';
import DistanceEstimator from '../components/studio/DistanceEstimator.astro';
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/header-unified.css';
import '../styles/google-panels.css';

interface Props { title: string; description: string; image?: string; }
const { title, description, image = 'https://raw.githubusercontent.com/prophloc/kaltruck-premium/main/public/images/home/hero-hds-kaltruck.webp' } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const headerServices = [
  "Kontenery i magazynowanie",
  "Suwnice przemysłowe",
  "Domki holenderskie",
  "Stacje ładowania",
  "Agregaty prądotwórcze",
  "Magazyny energii",
  "Stacje transformatorowe",
  "Baraki i stróżówki",
  "Domy szkieletowe",
  "Materiały budowlane",
  "Big-Bagi",
  "Płyty drogowe MON",
  "Ogrodzenia",
  "Prefabrykaty",
  "Ekrany akustyczne",
  "Kładki i wiadukty",
  "Rusztowania i szalunki",
  "Maszty energetyczne",
  "Wiatraki energetyczne",
  "Maszyny i urządzenia",
  "Sprzęt budowlany",
  "Zwoje kabli i kręgi",
  "Rury, słupy i latarnie",
  "Sejfy i kasy pancerne",
  "Silosy rolnicze",
  "Maszyny rolnicze",
  "Trawa i siano w rolkach",
  "Łodzie i jachty",
  "Gołębniki z trawersem",
  "Reklamy, billboardy i paczkomaty",
  "Eventy i imprezy masowe"
];
const canonical = site.url ? site.url + path : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.legalName,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'PL' },
  telephone: [site.phone, site.secondPhone],
  email: site.email,
  areaServed: [{ '@type': 'City', name: 'Płock' }, { '@type': 'Country', name: 'Polska' }],
  ...(site.url ? { url: site.url } : {}),
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={site.url ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    <meta name="theme-color" content="#14231e" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <header class="site-header home-header" data-studio-header>
      <div class="container header-inner">
        <a class="brand brand--image" href="/" aria-label="KALTRUCK Transport HDS — strona główna">
          <img class="studio-brand-logo" src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="KALTRUCK Transport HDS" />
        </a>
        <div class="studio-services-rotator" data-studio-services data-services={JSON.stringify(headerServices)} aria-label="Przykładowe usługi KALTRUCK">
          <span class="studio-services-label" data-studio-services-label>{headerServices[0]}</span>
        </div>
        <nav class="desktop-nav" aria-label="Menu główne">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Start</a>
          <div class="dropdown"><a href="/#uslugi" aria-current={path.startsWith('/uslugi/') ? 'page' : undefined}>Usługi</a>
            <div class="dropdown-list">{services.map((s) => <a href={'/uslugi/' + s.slug + '/'}>{s.title}</a>)}</div>
          </div>
          <a href="/realizacje/" aria-current={path === '/realizacje/' ? 'page' : undefined}>Realizacje</a>
          <a href="/o-nas/" aria-current={path === '/o-nas/' ? 'page' : undefined}>O nas</a>
          <a href="/kontakt/" aria-current={path === '/kontakt/' ? 'page' : undefined}>Kontakt</a>
        </nav>
        <div class="studio-header-contacts" aria-label="Telefony kontaktowe">
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
          <a href={`tel:${site.secondPhoneHref}`}>{site.secondPhone}</a>
        </div>
        <a class="button button-green header-cta" href="/kontakt/">Zapytaj o wycenę ↗</a>
        <button class="menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="Otwórz menu"><span></span><span></span></button>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Menu mobilne" hidden>
        <a href="/">Start</a><a href="/#uslugi">Usługi</a><a href="/realizacje/">Realizacje</a><a href="/o-nas/">O nas</a><a href="/kontakt/">Kontakt</a>
        <div class="mobile-nav__contacts"><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a href={`tel:${site.secondPhoneHref}`}>{site.secondPhone}</a><a href={`mailto:${site.email}`}>{site.email}</a></div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container studio-footer-route"><DistanceEstimator instanceId="studio-footer-route" /></div>
      <div class="container footer-head">
        <div><div class="eyebrow">KONTAKT / WYCENA</div><h2>Masz trudne<br /><em>zlecenie?</em></h2></div>
        <div><p>Opowiedz nam, co trzeba przewieźć lub ustawić. Dobierzemy rozwiązanie do warunków.</p><a class="footer-phone" href={'tel:' + site.phoneHref}>{site.phone} ↗</a><a href={'mailto:' + site.email}>{site.email}</a></div>
      </div>
      <div class="container footer-bottom"><a class="brand" href="/">KAL<span>TRUCK</span></a><span>Transport HDS Kalwasińscy · Płock · Polska</span><a href="#main">Do góry ↑</a></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
      const header = document.querySelector<HTMLElement>('[data-studio-header]');
      const updateHeader = () => header?.classList.toggle('scrolled', window.scrollY > 48);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
      const setMobileMenu = (open: boolean) => {
        if (!toggle || !mobileNav) return;
        toggle.setAttribute('aria-expanded', String(open));
        mobileNav.hidden = !open;
      };
      toggle?.addEventListener('click', () => setMobileMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMobileMenu(false)));
      document.addEventListener('keydown', e => { if (e.key === 'Escape') setMobileMenu(false); });
      const rotator = document.querySelector<HTMLElement>('[data-studio-services]');
      const rotatorLabel = rotator?.querySelector<HTMLElement>('[data-studio-services-label]');
      if (rotator && rotatorLabel && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let items: string[] = [];
        try { items = JSON.parse(rotator.dataset.services || '[]') as string[]; } catch { /* keep fallback */ }
        if (items.length > 1) {
          let i = 0;
          window.setInterval(() => {
            rotatorLabel.classList.add('is-changing');
            window.setTimeout(() => {
              i = (i + 1) % items.length;
              rotatorLabel.textContent = items[i];
              rotatorLabel.classList.remove('is-changing');
            }, 180);
          }, 3200);
        }
      }
    </script>
  </body>
</html>
