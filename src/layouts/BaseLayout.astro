---
import { site, services } from '../data/site';
import { buildPageSchemas, defaultOgImage } from '../lib/seo';
import DistanceEstimator from '../components/studio/DistanceEstimator.astro';
import PremiumFooter from '../components/studio/PremiumFooter.astro';
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/header-unified.css';
import '../styles/google-panels.css';
import '../styles/footer-refresh.css';

interface Props { title: string; description: string; image?: string; imageAlt?: string; jsonLd?: unknown | unknown[]; }
const { title, description, image = defaultOgImage, imageAlt, jsonLd = [] } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const headerServices = [
  "Kontenery i magazynowanie",
  "Suwnice przemysłowe",
  "Domki holenderskie",
  "Stacje ładowania",
  "Agregaty prądotwórcze",
  "Magazyny energii",
  "Stacje transformatorowe",
  "Baraki i stróżówki",
  "Domy szkieletowe",
  "Materiały budowlane",
  "Big-Bagi",
  "Płyty drogowe MON",
  "Ogrodzenia",
  "Prefabrykaty",
  "Ekrany akustyczne",
  "Kładki i wiadukty",
  "Rusztowania i szalunki",
  "Maszty energetyczne",
  "Wiatraki energetyczne",
  "Maszyny i urządzenia",
  "Sprzęt budowlany",
  "Zwoje kabli i kręgi",
  "Rury, słupy i latarnie",
  "Sejfy i kasy pancerne",
  "Silosy rolnicze",
  "Maszyny rolnicze",
  "Trawa i siano w rolkach",
  "Łodzie i jachty",
  "Gołębniki z trawersem",
  "Reklamy, billboardy i paczkomaty",
  "Eventy i imprezy masowe"
];
const canonical = site.url ? new URL(path, site.url).toString() : null;
const ogImage = image || defaultOgImage;
const defaultImage = ogImage === defaultOgImage;
const ogImageType = /\.png(?:[?#]|$)/i.test(ogImage) ? 'image/png' : /\.webp(?:[?#]|$)/i.test(ogImage) ? 'image/webp' : /\.jpe?g(?:[?#]|$)/i.test(ogImage) ? 'image/jpeg' : null;
const ogAlt = imageAlt || (defaultImage ? 'Czerwony samochód KALTRUCK HDS transportujący kontener — zdjęcie realizacji' : title + ' — zdjęcie realizacji KALTRUCK');
const extras = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const schemas = buildPageSchemas(path, title, description, ogImage, extras.filter(Boolean));
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={site.url ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    <meta name="theme-color" content="#14231e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="light" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {defaultImage && <meta property="og:image:width" content="1672" />}
    {defaultImage && <meta property="og:image:height" content="941" />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <header class="site-header home-header" data-studio-header data-home={isHome ? "true" : "false"}>
      <div class="container header-inner">
        <a class="brand brand--image" href="/" aria-label="KALTRUCK Transport HDS — strona główna">
          <img class="studio-brand-logo" src="/brand/kaltruck-logo.svg" width="2548" height="1305" alt="KALTRUCK Transport HDS" />
        </a>
        <div class="studio-services-rotator" data-studio-services data-services={JSON.stringify(headerServices)} aria-label="Przykładowe usługi KALTRUCK">
          <span class="studio-services-label" data-studio-services-label>{headerServices[0]}</span>
        </div>
        <nav class="desktop-nav" aria-label="Menu główne">
          <a href={isHome ? '/#start' : '/'} aria-current={isHome ? 'page' : undefined} data-nav-home data-nav-section="start">Start</a>
          <div class="dropdown"><a href="/#uslugi" data-nav-services data-nav-section="uslugi" aria-current={path.startsWith('/uslugi/') ? 'page' : undefined}>Usługi</a>
            <div class="dropdown-list">{services.map((s) => <a href={'/uslugi/' + s.slug + '/'} aria-current={path === '/uslugi/' + s.slug + '/' ? 'page' : undefined}>{s.title}</a>)}</div>
          </div>
          <a href={isHome ? '/#realizacje' : '/realizacje/'} data-nav-section="realizacje" aria-current={path === '/realizacje/' ? 'page' : undefined}>Realizacje</a>
          <a href={isHome ? '/#sprzet' : '/sprzet/'} data-nav-section="sprzet" aria-current={path === '/sprzet/' ? 'page' : undefined}>Sprzęt</a>
          <a href={isHome ? '/#o-nas' : '/o-nas/'} data-nav-section="o-nas" aria-current={path === '/o-nas/' ? 'page' : undefined}>O nas</a>
          <a href={isHome ? '/#kontakt' : '/kontakt/'} data-nav-section="kontakt" aria-current={path === '/kontakt/' ? 'page' : undefined}>Kontakt</a>
        </nav>
        <div class="studio-header-contacts" aria-label="Telefony kontaktowe">
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
        </div>
        <a class="button button-green header-cta" href="/kontakt/">Zapytaj o wycenę ↗</a>
        <button class="menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="Otwórz menu"><span></span><span></span></button>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Menu mobilne" hidden>
        <a href={isHome ? '/#start' : '/'} data-nav-section="start" data-mobile-nav-home aria-current={isHome ? 'page' : undefined}>Start</a>
        <a href="/#uslugi" data-nav-section="uslugi" data-mobile-nav-services aria-current={path.startsWith('/uslugi/') ? 'page' : undefined}>Usługi</a>
        <a href={isHome ? '/#realizacje' : '/realizacje/'} data-nav-section="realizacje" aria-current={path === '/realizacje/' ? 'page' : undefined}>Realizacje</a>
        <a href={isHome ? '/#sprzet' : '/sprzet/'} data-nav-section="sprzet" aria-current={path === '/sprzet/' ? 'page' : undefined}>Sprzęt</a>
        <a href={isHome ? '/#o-nas' : '/o-nas/'} data-nav-section="o-nas" aria-current={path === '/o-nas/' ? 'page' : undefined}>O nas</a>
        <a href={isHome ? '/#kontakt' : '/kontakt/'} data-nav-section="kontakt" aria-current={path === '/kontakt/' ? 'page' : undefined}>Kontakt</a>
        <div class="mobile-nav__tools" aria-label="Google Maps i opinie klientów">
          <a href="/?panel=route" data-studio-mobile-panel="route"><img class="mobile-nav__tool-image mobile-nav__tool-image--map" src="/brand/google-maps-wordmark.svg" alt="" aria-hidden="true" width="92" height="22" /><span>Sprawdź trasę</span></a>
          <a href="/?panel=reviews" data-studio-mobile-panel="reviews"><img class="mobile-nav__tool-image mobile-nav__tool-image--reviews" src="/brand/google-reviews-stars.svg" alt="" aria-hidden="true" width="75" height="32" /><span>Opinie Google</span></a>
        </div>
        <div class="mobile-nav__contacts"><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a href={`mailto:${site.email}`}>{site.email}</a></div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <section class="footer studio-footer" aria-labelledby="studio-footer-title">
      <div class="container studio-footer__shell">
        <div class="studio-footer__map-heading">
          <div>
            <p class="eyebrow">KALTRUCK / LOKALIZACJA</p>
            <h2 id="studio-footer-title">Zobacz trasę.<br /><em>Zaplanuj transport.</em></h2>
          </div>
          <div class="studio-footer__address">
            <span>BAZA FIRMY</span>
            <strong>Tokarska 40, 09-401 Płock</strong>
            <a href="https://www.google.com/maps/search/?api=1&amp;query=Tokarska%2040%2C%2009-401%20P%C5%82ock" target="_blank" rel="noopener noreferrer">Otwórz lokalizację w Google Maps ↗</a>
          </div>
        </div>
        <div class="studio-footer-route"><DistanceEstimator instanceId="studio-footer-route" /></div>
        <div class="studio-footer__contact">
          <div class="studio-footer__contact-copy">
            <p class="eyebrow">KONTAKT / WYCENA HDS</p>
            <h2>Masz ładunek?<br /><em>Zajmiemy się resztą.</em></h2>
            <p>Podaj rodzaj ładunku, miejsce odbioru i rozładunku. Pomożemy dobrać transport i sposób ustawienia.</p>
          </div>
          <div class="studio-footer__contact-actions">
            <span class="studio-footer__contact-kicker">ZADZWOŃ LUB NAPISZ</span>
            <a class="studio-footer__primary-number" href={`tel:${site.phoneHref}`}>{site.phone} <span>↗</span></a>
            <a class="studio-footer__email" href={`mailto:${site.email}`}>{site.email}</a>
            <a class="button button-green studio-footer__button" href="/kontakt/">Poproś o wycenę ↗</a>
          </div>
        </div>
      </div>
    </section>
    <PremiumFooter />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
      const header = document.querySelector<HTMLElement>('[data-studio-header]');
      const updateHeader = () => header?.classList.toggle('scrolled', window.scrollY > 48);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
      // Horizontal V3 handles section highlighting for all six menu tabs.
      // Standalone service, contact, equipment and gallery pages keep server-rendered state.
      const setMobileMenu = (open: boolean) => {
        if (!toggle || !mobileNav) return;
        toggle.setAttribute('aria-expanded', String(open));
        mobileNav.hidden = !open;
      };
      toggle?.addEventListener('click', () => setMobileMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      mobileNav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMobileMenu(false)));
      document.addEventListener('keydown', e => { if (e.key === 'Escape') setMobileMenu(false); });
      const rotator = document.querySelector<HTMLElement>('[data-studio-services]');
      const rotatorLabel = rotator?.querySelector<HTMLElement>('[data-studio-services-label]');
      if (rotator && rotatorLabel && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let items: string[] = [];
        try { items = JSON.parse(rotator.dataset.services || '[]') as string[]; } catch { /* keep fallback */ }
        if (items.length > 1) {
          let i = 0;
          window.setInterval(() => {
            rotatorLabel.classList.add('is-changing');
            window.setTimeout(() => {
              i = (i + 1) % items.length;
              rotatorLabel.textContent = items[i];
              rotatorLabel.classList.remove('is-changing');
            }, 180);
          }, 3200);
        }
      }
    </script>
  </body>
</html>
