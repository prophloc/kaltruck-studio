---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services, site } from '../../data/site';
import { guides } from '../../data/service-guides';
import { serviceSeo, serviceSchema, faqSchema } from '../../lib/seo';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const seo = serviceSeo[service.slug];
const guide = guides[service.slug];
const serviceJsonLd = site.url ? [serviceSchema(service.slug, service.title, seo.description), faqSchema(guide.faq)] : [];
---
<BaseLayout title={seo.title} description={seo.description} image={service.image} imageAlt={service.title + ' — przykładowa realizacja KALTRUCK HDS'} jsonLd={serviceJsonLd}>
  <section class="subhero">
    <div class="container subhero-grid">
      <div><p class="eyebrow">{service.number} / USŁUGA KALTRUCK</p><h1>{service.title}</h1><p class="section-lead">{service.tagline}</p><a class="button button-green" href="/kontakt/">Zapytaj o wycenę ↗</a></div>
      <img src={service.image} alt={service.title + ' — przykładowa realizacja KALTRUCK'} />
    </div>
  </section>
  <section class="section"><div class="container split-content"><div><p class="eyebrow">ZAKRES PRAC</p><h2>Przemyślana<br /><em>realizacja.</em></h2></div><div><p class="section-lead">{service.description}</p><ul class="feature-list">{service.details.map((detail) => <li>{detail}</li>)}</ul><p>Obsługujemy Płock i okolice oraz zlecenia na terenie całej Polski. Zakres prac ustalamy indywidualnie na podstawie informacji o ładunku i miejscu realizacji.</p><a class="text-link" href="/kontakt/">Porozmawiajmy o realizacji ↗</a></div></div></section>
  <section class="section studio-service-guide" aria-labelledby="studio-guide-title">
    <div class="container studio-service-guide__grid">
      <div>
        <p class="eyebrow">WARTO WIEDZIEĆ</p>
        <h2 id="studio-guide-title">{guide.heading}</h2>
        <p class="studio-service-guide__intro">{guide.intro}</p>
        <p><a class="text-link" href="/realizacje/">Zobacz zdjęcia naszych realizacji ↗</a></p>
      </div>
      <div class="studio-service-guide__steps">
        {guide.preparation.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section studio-service-faq" aria-labelledby="studio-service-faq-title">
    <div class="container studio-service-faq__grid">
      <div><p class="eyebrow">PYTANIA I ODPOWIEDZI</p><h2 id="studio-service-faq-title">Przed zamówieniem HDS.</h2></div>
      <div>
        {guide.faq.map((question) => (
          <details>
            <summary>{question.question}<span aria-hidden="true">+</span></summary>
            <p>{question.answer}</p>
          </details>
        ))}
        <a class="text-link" href="/kontakt/">Zapytaj o swoje zlecenie ↗</a>
      </div>
    </div>
  </section>
  <section class="section services-section"><div class="container"><p class="eyebrow">POZOSTAŁE USŁUGI</p><h2>Sprawdź też.</h2><div class="related-list">{services.filter((s) => s.slug !== service.slug).map((s) => <a href={'/uslugi/' + s.slug + '/'}>{s.title} <span>↗</span></a>)}</div></div></section>
</BaseLayout>

<style>
  .studio-service-guide{background:var(--paper);}
  .studio-service-guide__grid,.studio-service-faq__grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(28px,6vw,90px);}
  .studio-service-guide h2,.studio-service-faq h2{font-size:clamp(2.25rem,4.2vw,4.2rem);line-height:1.1;letter-spacing:-.055em;margin:15px 0 23px;max-width:17ch;}
  .studio-service-guide__intro{font-size:clamp(1rem,1.35vw,1.15rem);line-height:1.8;max-width:58ch;color:#5b7064;}
  .studio-service-guide__steps{display:grid;gap:13px;}
  .studio-service-guide__steps article{background:#f2f4ed;border:1px solid #d8e1d3;border-radius:13px;padding:22px 26px;}
  .studio-service-guide__steps article>span{display:inline-flex;font-size:11px;font-weight:900;color:#487337;letter-spacing:.1em;}
  .studio-service-guide__steps h3{font-size:clamp(1.12rem,1.6vw,1.45rem);margin:13px 0 7px;line-height:1.25;}
  .studio-service-guide__steps p{font-size:15px;line-height:1.8;color:#5b7064;margin:0;}
  .studio-service-faq{background:var(--cream);}
  .studio-service-faq details{border-bottom:1px solid #d4ded0;padding:20px 4px;}
  .studio-service-faq summary{cursor:pointer;display:flex;gap:14px;align-items:center;justify-content:space-between;font-size:clamp(1.06rem,1.45vw,1.27rem);font-weight:750;line-height:1.4;list-style:none;}
  .studio-service-faq summary::-webkit-details-marker{display:none;}
  .studio-service-faq summary>span{font-size:24px;color:#527f39;line-height:1;}
  .studio-service-faq details[open] summary>span{transform:rotate(45deg);}
  .studio-service-faq details p{font-size:15px;line-height:1.85;color:#617368;max-width:57ch;padding:4px 0 0;}
  .studio-service-faq .text-link{display:inline-block;margin-top:24px;}
  @media(max-width:850px){.studio-service-guide__grid,.studio-service-faq__grid{grid-template-columns:1fr;gap:25px;}}
  @media(max-width:600px){.studio-service-guide__steps article{padding:19px;}.studio-service-guide__steps p,.studio-service-faq details p{font-size:14px;}}
</style>
