---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Kontakt i wycena transportu HDS | KALTRUCK Płock" description="Skontaktuj się z KALTRUCK. Zapytaj o wycenę transportu HDS, załadunku, rozładunku i montażu. Płock i cała Polska.">
  <section class="subhero"><div class="container narrow"><p class="eyebrow">KONTAKT / WYCENA</p><h1>Porozmawiajmy<br /><em>o szczegółach.</em></h1><p class="section-lead">Prześlij informacje o ładunku, miejscu załadunku i rozładunku. Pomożemy ustalić dalsze kroki.</p></div></section>
  <section class="section contact-section"><div class="container contact-grid">
    <div class="contact-details">
      <p class="eyebrow">BEZPOŚREDNI KONTAKT</p>
      <a class="contact-phone" href={'tel:' + site.phoneHref}>{site.phone} ↗</a>
      <a class="contact-phone secondary" href={'tel:' + site.secondPhoneHref}>{site.secondPhone}</a>
      <a class="contact-mail" href={'mailto:' + site.email}>{site.email}</a>
      <div class="contact-location"><span>PŁOCK</span><p>Realizacje lokalne i ogólnopolskie</p></div>
    </div>
    <div class="form-panel"><h2>Opisz zlecenie.</h2><p>Formularz przygotuje wiadomość w Twoim programie pocztowym. Nie wysyła danych na serwer.</p>
      <form id="quote-form">
        <label for="person">Imię / firma</label><input required id="person" name="person" autocomplete="name" />
        <label for="phone">Telefon kontaktowy</label><input id="phone" name="phone" autocomplete="tel" />
        <label for="service">Rodzaj usługi</label><select name="service" id="service"><option>Transport HDS</option><option>Transport kontenerów</option><option>Transport maszyn</option><option>Transport prefabrykatów</option><option>Rozładunek HDS</option><option>Wynajem HDS</option><option>Inne</option></select>
        <label for="details">Opis ładunku i trasy</label><textarea required id="details" name="details" rows="5" placeholder="Co, skąd, dokąd i kiedy?"></textarea>
        <button class="button button-green" type="submit">Przygotuj e-mail ↗</button>
      </form>
    </div>
  </div></section>
  <script>
    const quoteForm = document.querySelector<HTMLFormElement>('#quote-form');
    quoteForm?.addEventListener('submit', event => {
      event.preventDefault();
      if (!quoteForm.reportValidity()) return;
      const data = new FormData(quoteForm);
      const get = (key: string) => String(data.get(key) || '');
      const message = ['Imię / firma: ' + get('person'), 'Telefon: ' + get('phone'), 'Usługa: ' + get('service'), '', 'Opis: ', get('details')].join('\n');
      const address = 'hds.plock@gmail.com';
      window.location.href = 'mailto:' + address + '?subject=' + encodeURIComponent('Wycena HDS — KALTRUCK') + '&body=' + encodeURIComponent(message);
    });
  </script>
</BaseLayout>
