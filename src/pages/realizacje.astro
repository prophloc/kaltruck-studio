---
import BaseLayout from '../layouts/BaseLayout.astro';
import { realizations, realizationGroups, galleryByGroup } from '../data/realizations';
const categories = ['Wszystkie', ...realizationGroups];
const previews = realizationGroups.map((category) => ({
  category,
  project: realizations.find((p) => p.group === category)!
}));
---
<BaseLayout title="Realizacje transportu HDS | KALTRUCK Płock" description="Realizacje KALTRUCK HDS: ponad 70 zdjęć z 10 projektów — kontenery, prefabrykaty, energetyka, maszyny rolnicze i reklamy. Zobacz galerie i zdjęcia szczegółowe.">
  <section class="subhero gallery-subhero" aria-labelledby="gallery-heading">
    <div class="container gallery-subhero__grid">
      <div class="gallery-subhero__copy">
        <p class="eyebrow">KALTRUCK / NASZE REALIZACJE</p>
        <h1 id="gallery-heading" class="gallery-hero-title"><span class="gallery-hero-title__first">To nasza <strong>praca.</strong></span><span class="gallery-hero-title__second">Na zdjęciach.</span></h1>
        <p class="section-lead">Zdjęcia z rzeczywistych zleceń. Wybierz kategorię albo otwórz realizację, aby przejrzeć wszystkie dostępne fotografie.</p>
      </div>
      <aside class="gallery-preview" aria-label="Zobacz kategorie realizacji">
        <p class="gallery-preview__intro">Poznaj zakres naszych realizacji.</p>
        <div class="gallery-preview__grid">
          {previews.map(({ category, project }, i) => (
            <a class="gallery-preview__card" href="#realization-gallery" data-preview-category={category} aria-label={'Przejdź do realizacji: ' + category}>
              <img src={project.image} alt="" aria-hidden="true" loading={i < 2 ? 'eager' : 'lazy'} width={project.width} height={project.height} />
              <span>{category}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section gallery-section" id="realization-gallery" aria-labelledby="gallery-list-heading">
    <div class="container">
      <div class="gallery-section__heading">
        <div><p class="eyebrow">ZOBACZ WIĘCEJ</p><h2 id="gallery-list-heading">Galeria <span>realizacji.</span></h2></div>
        <p>10 zleceń · {realizations.reduce((count, p) => count + p.images.length, 0)} zdjęć</p>
      </div>
      <div class="gallery-filters" role="group" aria-label="Filtruj realizacje">
        {categories.map((category, i) => <button class:list={['filter-button', { active: i === 0 }]} data-filter={category} aria-pressed={i === 0} type="button">{category}</button>)}
      </div>
      <div class="gallery-grid">
        {realizations.map((project) => (
          <button class="gallery-item" data-category={project.group} data-gallery-project={project.id} data-start-src={project.image} type="button" aria-label={'Otwórz galerię: ' + project.title + ', ' + project.images.length + ' zdjęć'}>
            <img src={project.image} alt={project.alt} width={project.width} height={project.height} loading="lazy" decoding="async" />
            <span class="gallery-caption"><small>{project.category} · {project.images.length} zdjęć</small><strong>{project.title} ↗</strong></span>
          </button>
        ))}
      </div>
    </div>
  </section>
  <dialog class="lightbox gallery-lightbox" id="photo-lightbox" aria-label="Zdjęcia realizacji KALTRUCK">
    <button class="lightbox-close" type="button" aria-label="Zamknij galerię">✕</button>
    <button class="lightbox-prev" type="button" aria-label="Poprzednie zdjęcie">←</button>
    <figure>
      <img id="lightbox-image" alt="" width="1200" height="900" />
      <figcaption id="lightbox-caption"></figcaption>
      <small class="gallery-lightbox__counter" aria-live="polite" data-gallery-counter></small>
    </figure>
    <button class="lightbox-next" type="button" aria-label="Następne zdjęcie">→</button>
    <div class="gallery-lightbox__thumbs" data-gallery-thumbs aria-label="Miniatury zdjęć tej kategorii"></div>
  </dialog>
  <script is:inline type="application/json" id="gallery-photographs" set:html={JSON.stringify(galleryByGroup).replace(/</g, '\\u003c')}></script>

  <script>
    type ImageItem = {src:string;alt:string;title:string;summary:string};
    const cards = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-project]')];
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const dlg = document.querySelector<HTMLDialogElement>('#photo-lightbox');
    const currentImage = dlg?.querySelector<HTMLImageElement>('#lightbox-image');
    const label = dlg?.querySelector<HTMLElement>('#lightbox-caption');
    const counter = dlg?.querySelector<HTMLElement>('[data-gallery-counter]');
    const thumbRow = dlg?.querySelector<HTMLElement>('[data-gallery-thumbs]');
    const json = document.querySelector<HTMLScriptElement>('#gallery-photographs');
    let byGroup: Record<string,ImageItem[]> = {};
    try { byGroup = JSON.parse(json?.textContent || '{}'); } catch { /* no photo list */ }
    let currentCategory = '';
    let currentIndex = 0;
    let lastTrigger: HTMLElement | null = null;
    let touchX = 0;

    const entries = () => byGroup[currentCategory] || [];
    const render = () => {
      const photos=entries();
      if (!photos.length || !currentImage || !label || !counter) return;
      currentIndex=(currentIndex+photos.length)%photos.length;
      const photo=photos[currentIndex];
      currentImage.src=photo.src;
      currentImage.alt=photo.alt;
      label.textContent=photo.title + ' — ' + photo.summary;
      counter.textContent=(currentIndex+1) + ' / ' + photos.length;
      thumbRow?.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((thumb,i)=>{
        thumb.classList.toggle('is-current',i===currentIndex);
        thumb.setAttribute('aria-current',i===currentIndex?'true':'false');
        if(i===currentIndex)thumb.scrollIntoView({block:'nearest',inline:'nearest'});
      });
    };
    const paintThumbs = () => {
      if(!thumbRow)return;
      thumbRow.replaceChildren();
      entries().forEach((item,index)=>{
        const button=document.createElement('button');
        button.className='gallery-lightbox__thumb';
        button.type='button';
        button.setAttribute('data-gallery-thumb','');
        button.setAttribute('aria-label','Zdjęcie '+(index+1)+': '+item.title);
        const img=document.createElement('img');
        img.src=item.src;img.alt='';img.width=82;img.height=62;img.loading='lazy';
        button.append(img);
        button.addEventListener('click',()=>{currentIndex=index;render();});
        thumbRow.append(button);
      });
    };
    const selectCategory = (category:string) => {
      filters.forEach(button=>{
        const selected=button.dataset.filter===category;
        button.classList.toggle('active',selected);
        button.setAttribute('aria-pressed',String(selected));
      });
      cards.forEach(card=>{card.hidden=category!=='Wszystkie' && card.dataset.category!==category;});
    };
    filters.forEach(button=>button.addEventListener('click',()=>selectCategory(button.dataset.filter||'Wszystkie')));
    document.querySelectorAll<HTMLAnchorElement>('[data-preview-category]').forEach(preview=>{
      preview.addEventListener('click',()=>selectCategory(preview.dataset.previewCategory||'Wszystkie'));
    });
    cards.forEach(card=>card.addEventListener('click',()=>{
      if(!dlg || !entries)return;
      currentCategory=card.dataset.category||'';
      const photos=entries();
      currentIndex=Math.max(0,photos.findIndex(photo=>photo.src===card.dataset.startSrc));
      lastTrigger=card;paintThumbs();render();dlg.showModal();
    }));
    const change=(direction:number)=>{currentIndex+=direction;render();};
    dlg?.querySelector('.lightbox-prev')?.addEventListener('click',()=>change(-1));
    dlg?.querySelector('.lightbox-next')?.addEventListener('click',()=>change(1));
    dlg?.querySelector('.lightbox-close')?.addEventListener('click',()=>dlg?.close());
    dlg?.addEventListener('click',event=>{if(event.target===dlg)dlg.close();});
    dlg?.addEventListener('close',()=>lastTrigger?.focus());
    dlg?.addEventListener('keydown',event=>{
      if(event.key==='ArrowRight'){event.preventDefault();change(1);}
      if(event.key==='ArrowLeft'){event.preventDefault();change(-1);}
    });
    dlg?.addEventListener('touchstart',event=>{touchX=event.changedTouches[0]?.clientX||0;},{passive:true});
    dlg?.addEventListener('touchend',event=>{
      const dx=(event.changedTouches[0]?.clientX||0)-touchX;
      if(Math.abs(dx)>55)change(dx<0?1:-1);
    },{passive:true});
  </script>
</BaseLayout>
<style is:global>
  .gallery-subhero{overflow:hidden;}
  .gallery-subhero__grid{display:grid;grid-template-columns:minmax(0,1.03fr) minmax(0,.97fr);align-items:center;gap:clamp(28px,4vw,65px);max-width:1380px;}
  .gallery-subhero__copy{min-width:0;}
  .gallery-hero-title{max-width:none;display:flex;flex-direction:column;align-items:flex-start;gap:5px;font-size:clamp(3rem,5.2vw,6.5rem);line-height:1.08;}
  .gallery-hero-title__first{display:block;white-space:nowrap;font-family:inherit;font-weight:800;letter-spacing:-.067em;}
  .gallery-hero-title__first strong{color:var(--green);font-weight:inherit;}
  .gallery-hero-title__second{display:block;font-family:Georgia,serif;font-weight:400;font-style:italic;letter-spacing:-.077em;}
  .gallery-preview{min-width:0;}
  .gallery-preview__intro{margin:0 0 16px;color:#c5d3c7;font-size:14px;}
  .gallery-preview__grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;}
  .gallery-preview__card{position:relative;isolation:isolate;min-width:0;min-height:120px;display:block;border:1px solid rgba(255,255,255,.17);border-radius:12px;overflow:hidden;background:#101c19;transition:transform .23s,border-color .23s;}
  .gallery-preview__card:last-child{grid-column:1/-1;width:calc((100% - 9px)/2);justify-self:center;}
  .gallery-preview__card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.68);transition:transform .3s;}
  .gallery-preview__card::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(8,15,12,.26));pointer-events:none;}
  .gallery-preview__card span{position:absolute;z-index:1;top:50%;left:0;right:0;transform:translateY(-50%);display:block;padding:10px 9px;background:rgba(7,18,13,.48);backdrop-filter:blur(7px);text-align:center;font-size:clamp(11px,.9vw,13px);line-height:1.25;font-weight:800;color:#fff;}
  .gallery-preview__card:hover{transform:translateY(-2px);border-color:var(--green);}
  .gallery-preview__card:hover img{transform:scale(1.04);}
  .gallery-section{scroll-margin-top:112px;}
  .gallery-section__heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:28px;}
  .gallery-section__heading h2{font-size:clamp(2rem,3.5vw,3.5rem);margin:0;}
  .gallery-section__heading h2 span{color:#618e42;}
  .gallery-section__heading > p{color:#587060;font-size:13px;margin:0 0 7px;white-space:nowrap;}
  .gallery-grid{align-items:stretch;}
  .lightbox.gallery-lightbox{padding:58px 70px 112px;}
  .lightbox.gallery-lightbox figure{height:100%;gap:9px;}
  .lightbox.gallery-lightbox figure img{max-height:calc(100dvh - 247px);}
  .gallery-lightbox__counter{color:#bcd8a0;font-size:12px;letter-spacing:.08em;}
  .gallery-lightbox__thumbs{position:absolute;bottom:13px;left:70px;right:70px;display:flex;align-items:center;gap:7px;overflow:auto;scrollbar-width:thin;min-height:74px;padding:6px 4px;}
  .lightbox.gallery-lightbox .gallery-lightbox__thumb{flex:0 0 75px;position:relative;display:block;width:75px;height:58px;padding:0;border-radius:6px;border:2px solid transparent;background:#213528;overflow:hidden;}
  .lightbox.gallery-lightbox .gallery-lightbox__thumb.is-current{border-color:var(--green);}
  .gallery-lightbox__thumb img{width:100%;height:100%;object-fit:cover;}
  @media(max-width:980px){
    .gallery-subhero__grid{grid-template-columns:1fr;gap:30px;}
    .gallery-preview{max-width:690px;}
    .gallery-preview__grid{display:flex;overflow-x:auto;scroll-snap-type:x proximity;padding:3px 2px 10px;scrollbar-width:none;}
    .gallery-preview__grid::-webkit-scrollbar{display:none;}
    .gallery-preview__card,.gallery-preview__card:last-child{flex:0 0 min(56vw,240px);width:auto;min-height:110px;scroll-snap-align:start;}
  }
  @media(max-width:700px){
    .gallery-subhero{padding-top:146px;}
    .gallery-hero-title{font-size:clamp(2.2rem,8vw,3.65rem);}
    .gallery-section__heading{align-items:start;flex-direction:column;gap:8px;}
    .lightbox.gallery-lightbox{padding:64px 38px 114px;}
    .lightbox.gallery-lightbox figure img{max-height:calc(100dvh - 285px);}
    .gallery-lightbox__thumbs{left:30px;right:30px;bottom:15px;}
    .lightbox.gallery-lightbox .gallery-lightbox__thumb{flex-basis:63px;width:63px;height:50px;}
  }
  @media(max-width:390px){
    .gallery-hero-title{font-size:clamp(1.95rem,8vw,2.55rem);}
    .gallery-preview__card,.gallery-preview__card:last-child{flex-basis:70vw;}
  }
</style>
