---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTools from '../components/studio/HeroTools.astro';
import DistanceEstimator from '../components/studio/DistanceEstimator.astro';
import { site, services, projects } from '../data/site';
import '../styles/horizontal.css';

const heroPhoto = 'https://raw.githubusercontent.com/prophloc/kaltruck-premium/main/public/images/home/hero-hds-original.png';
const storyPhotos = {
  services: 'https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg',
  equipment: 'https://hdsplock.pl/zdj/realizacje/transport-przemys-owy-03.jpg',
  projects: 'https://hdsplock.pl/zdj/realizacje/stacje-transformatorowe-07.jpg',
  about: 'https://hdsplock.pl/zdj/realizacje/domy-szkieletowe-02.jpg',
  contact: 'https://hdsplock.pl/zdj/realizacje/transport-kontenerow-03.jpg',
};
const featuredProjects = [projects[0], projects[1], projects[2], projects[4]];
const stages = [
  ['01', 'Opis zlecenia', 'Ładunek, wymiary, ciężar i adresy.'],
  ['02', 'Ocena warunków', 'Dojazd, miejsce postoju i zasięg HDS.'],
  ['03', 'Plan i wycena', 'Zakres prac, termin i sposób rozładunku.'],
  ['04', 'Realizacja', 'Przewóz, podniesienie i ustawienie.'],
];
const questions = [
  ['Gdzie działacie?', 'Baza firmy znajduje się w Płocku. Obsługujemy również zlecenia na terenie całej Polski.'],
  ['Czy ustawicie ładunek w miejscu docelowym?', 'Tak, jeżeli masa, promień pracy, podłoże i warunki dojazdu pozwolą na bezpieczną pracę HDS.'],
  ['Co podać do wyceny?', 'Rodzaj, wymiary i masę ładunku, miejsce odbioru i rozładunku oraz informacje o dojeździe.'],
];
---
<BaseLayout title="Transport HDS Płock i cała Polska | KALTRUCK Kalwasińscy" image={heroPhoto} description="Transport HDS w Płocku i całej Polsce: kontenery, maszyny, prefabrykaty, wynajem HDS i rozładunek. Poznaj wszystkie usługi KALTRUCK.">
  <div class="horizontal-track" id="horizontal-track" aria-label="KALTRUCK — przewijana poziomo prezentacja oferty">
    <section class="hz-slide hz-hero home-hero" id="start" aria-labelledby="hz-hero-title">
      <img class="hz-photo hz-photo--hero" src={heroPhoto} width="1672" height="941" alt="Czerwony samochód ciężarowy KALTRUCK HDS przewożący kontener" fetchpriority="high" decoding="async" />
      <HeroTools />
      <div class="hz-container hz-hero__body">
        <div class="hz-kicker"><span class="hz-line"></span> KALTRUCK / TRANSPORT HDS / PŁOCK · POLSKA</div>
        <h1 id="hz-hero-title">CIĘŻKIE ZADANIA.<br /><span>PEWNE <em>ROZWIĄZANIA.</em></span></h1>
        <p>Transport i załadunek HDS w jednym. Kontenery, maszyny, prefabrykaty i nietypowe ładunki — od odbioru po ustawienie na miejscu.</p>
        <div class="hz-actions">
          <a class="button button-green" href="#uslugi">Zobacz wszystkie usługi ↗</a>
          <a class="hz-outline" href="#kontakt">Zapytaj o transport ↗</a>
        </div>
      </div>
      <div class="hz-hero__bottom hz-container" aria-label="Możliwości KALTRUCK">
        <div><strong>10+</strong><span>lat doświadczenia</span></div>
        <div><strong>12 t</strong><span>udźwig HDS do</span></div>
        <div><strong>14 m</strong><span>zasięg ramienia do</span></div>
        <div><strong>Polska</strong><span>obszar realizacji</span></div>
        <a href="#uslugi" class="hz-hero__discover">ODKRYJ OFERTĘ <span>→</span></a>
      </div>
    </section>

    <section class="hz-slide hz-services" id="uslugi" aria-labelledby="hz-services-title">
      <img class="hz-photo" src={storyPhotos.services} alt="" loading="lazy" decoding="async" />
      <div class="hz-container hz-services__grid">
        <div class="hz-services__intro">
          <p class="hz-kicker"><span class="hz-line"></span> 01 / OFERTA KALTRUCK</p>
          <h2 id="hz-services-title">Wszystkie usługi.<br /><em>W jednym miejscu.</em></h2>
          <p>Nie musisz przeskakiwać przez sześć osobnych ekranów. Wybierz rodzaj zlecenia — pod każdym znajdziesz opis i szczegóły.</p>
          <a class="hz-inline-link" href="#kontakt">Nie wiesz, który HDS wybrać? Zapytaj ↗</a>
        </div>
        <div class="hz-services__board">
          <div class="hz-services__board-top"><span>ZAKRES USŁUG</span><span>06 SPECJALIZACJI</span></div>
          <div class="hz-services__list">
            {services.map((service) => (
              <a href={`/uslugi/${service.slug}/`} class="hz-service">
                <span class="hz-service__num">{service.number}</span>
                <span class="hz-service__body"><strong>{service.title}</strong><small>{service.tagline}</small><span>{service.description}</span></span>
                <span class="hz-service__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <div class="hz-services__board-bottom">TRANSPORT <span>•</span> ZAŁADUNEK <span>•</span> ROZŁADUNEK <span>•</span> USTAWIENIE</div>
        </div>
      </div>
    </section>

    <section class="hz-slide hz-projects" id="realizacje" aria-labelledby="hz-projects-title">
      <img class="hz-photo" src={storyPhotos.projects} alt="" loading="lazy" decoding="async" />
      <div class="hz-container hz-projects__layout">
        <div class="hz-projects__intro">
          <p class="hz-kicker"><span class="hz-line"></span> 02 / REALIZACJE</p>
          <h2 id="hz-projects-title">Nie tylko mówimy.<br /><em>Pokazujemy.</em></h2>
          <p>Transport kontenerów, elementów konstrukcyjnych, infrastruktury i urządzeń przemysłowych. Zobacz zdjęcia wykonanych prac.</p>
          <a class="hz-inline-link" href="/realizacje/">Otwórz pełną galerię realizacji ↗</a>
        </div>
        <div class="hz-projects__cards">
          {featuredProjects.map((project) => (
            <a class="hz-project" href="/realizacje/" aria-label={project.title + ' — zobacz galerię'}>
              <img src={project.image} alt={project.alt} loading="lazy" decoding="async" />
              <span><small>{project.category}</small><strong>{project.title}</strong></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="hz-slide hz-equipment" id="sprzet" aria-labelledby="hz-equipment-title">
      <img class="hz-photo" src={storyPhotos.equipment} alt="" loading="lazy" decoding="async" />
      <div class="hz-container hz-equipment__layout">
        <div class="hz-equipment__main">
          <p class="hz-kicker"><span class="hz-line"></span> 03 / SPRZĘT I MOŻLIWOŚCI</p>
          <h2 id="hz-equipment-title">Wiemy, jak<br /><em>ruszyć ciężar.</em></h2>
          <p>Łączymy samochód transportowy i żuraw HDS w jednej realizacji. Dobór sprzętu zależy od masy ładunku, dojazdu i miejsca ustawienia.</p>
          <div class="hz-equipment__stats">
            <div><strong>12 t</strong><span>maksymalny udźwig</span></div>
            <div><strong>14 m</strong><span>zasięg ramienia</span></div>
            <div><strong>10+</strong><span>lat doświadczenia</span></div>
          </div>
          <a class="hz-inline-link" href="/sprzet/">Zobacz sprzęt i możliwości ↗</a>
        </div>
        <div class="hz-process">
          <span class="hz-process__header">JAK PRACUJEMY <span>4 PROSTE KROKI</span></span>
          {stages.map(([num, name, detail]) => (
            <div class="hz-process__step"><span>{num}</span><div><strong>{name}</strong><small>{detail}</small></div></div>
          ))}
        </div>
      </div>
    </section>

    <section class="hz-slide hz-about" id="o-nas" aria-labelledby="hz-about-title">
      <img class="hz-photo" src={storyPhotos.about} alt="" loading="lazy" decoding="async" />
      <div class="hz-container hz-about__layout">
        <div class="hz-about__story">
          <p class="hz-kicker"><span class="hz-line"></span> 04 / O NAS</p>
          <h2 id="hz-about-title">Transport<br /><em>z charakterem.</em></h2>
          <p>Jesteśmy zespołem KALTRUCK — Transport HDS Kalwasińscy. Specjalizujemy się w transporcie ładunków, które wymagają nie tylko przewozu, ale także załadunku, rozładunku i precyzyjnego ustawienia.</p>
          <p>Naszą bazą jest Płock, ale działamy w całej Polsce. Dopasowujemy sposób realizacji do masy, gabarytów, warunków dojazdu i zasięgu żurawia.</p>
          <div class="hz-about__tags"><span>TRANSPORT</span><span>HDS</span><span>PRZEŁADUNKI</span><span>MONTAŻ</span></div>
          <a class="hz-inline-link" href="/o-nas/">Poznaj firmę KALTRUCK ↗</a>
        </div>
        <div class="hz-faq">
          <div class="hz-faq__heading"><span>NAJCZĘSTSZE PYTANIA</span><span>FAQ</span></div>
          {questions.map(([q, a]) => (
            <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>
          ))}
          <a href="#kontakt" class="hz-faq__foot">Porozmawiajmy o Twoim transporcie <span>→</span></a>
        </div>
      </div>
    </section>
    <section class="hz-slide hz-contact" id="kontakt" aria-labelledby="hz-contact-title">
      <img class="hz-photo" src={storyPhotos.contact} alt="" loading="lazy" decoding="async" />
      <div class="hz-container hz-contact__layout hz-contact__layout--map">
        <div class="hz-contact__intro">
          <p class="hz-kicker"><span class="hz-line"></span> 05 / KONTAKT I LOKALIZACJA</p>
          <h2 id="hz-contact-title">Masz ładunek?<br /><em>Zajmiemy się resztą.</em></h2>
          <p>Powiedz nam, co, skąd i dokąd trzeba przewieźć. Dobierzemy transport HDS do ładunku i warunków rozładunku.</p>
          <div class="hz-contact__details" aria-label="Dane kontaktowe KALTRUCK">
            <span>BEZPOŚREDNI KONTAKT</span>
            <a class="hz-contact__phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
            <a class="hz-contact__email" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="hz-actions">
            <a class="button button-green" href="/kontakt/">Wyślij zapytanie o wycenę ↗</a>
          </div>
          <a class="hz-contact__base" href="https://www.google.com/maps/search/?api=1&amp;query=Tokarska%2040%2C%2009-401%20P%C5%82ock" target="_blank" rel="noopener noreferrer">BAZA FIRMY · Tokarska 40, 09-401 Płock ↗</a>
        </div>
        <div class="hz-contact__map" aria-label="Interaktywna mapa Google i planowanie trasy">
          <DistanceEstimator instanceId="horizontal-final-route" variant="drawer" deferMap={false} />
        </div>
      </div>
    </section>

  </div>
  <nav class="horizontal-progress" aria-label="Nawigacja pomiędzy sekcjami">
    <button type="button" data-prev aria-label="Poprzednia sekcja">←</button>
    <span data-count aria-live="polite">01 / 06</span>
    <span class="horizontal-progress__bar"><span class="horizontal-progress__fill" data-fill></span></span>
    <button type="button" data-next aria-label="Następna sekcja">→</button>
  </nav>
  <script is:inline src="/horizontal-scroll.js"></script>
</BaseLayout>
