---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapabilityStrip from '../components/studio/CapabilityStrip.astro';
import ServiceStory from '../components/studio/ServiceStory.astro';
import EquipmentSection from '../components/studio/EquipmentSection.astro';
import ProcessSteps from '../components/studio/ProcessSteps.astro';
import FAQSection from '../components/studio/FAQSection.astro';
import CTASection from '../components/studio/CTASection.astro';
import '../styles/premium-layout.css';
import HeroTools from '../components/studio/HeroTools.astro';
---
<BaseLayout title="Transport HDS Płock i cała Polska | KALTRUCK Kalwasińscy" image="https://raw.githubusercontent.com/prophloc/kaltruck-premium/main/public/images/home/hero-hds-original.png" description="Transport HDS w Płocku i całej Polsce. Przewóz kontenerów, maszyn, prefabrykatów oraz załadunek i rozładunek HDS.">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <HeroTools />
    <div class="home-hero__media">
      <img
        class="home-hero__photo"
        src="https://raw.githubusercontent.com/prophloc/kaltruck-premium/main/public/images/home/hero-hds-original.png"
        alt="Czerwony samochód HDS KALTRUCK z żurawiem podnoszącym kontener"
        width="1672"
        height="941"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="container home-hero__content">
      <p class="home-hero__eyebrow"><span class="home-hero__line"></span> KALTRUCK / TRANSPORT HDS / PŁOCK I POLSKA</p>
      <h1 id="home-hero-title" class="home-hero__title">
        <span>CIĘŻKIE ZADANIA.</span>
        <span>PEWNE <strong class="home-hero__accent">ROZWIĄZANIA.</strong></span>
      </h1>
      <p class="home-hero__description">Specjalistyczny transport, precyzyjny załadunek i rozładunek HDS. Od kontenerów i maszyn po wymagające projekty przemysłowe.</p>
      <div class="home-hero__actions">
        <a class="button button-green" href="/#uslugi">Nasze usługi ↗</a>
        <a class="button home-hero__secondary" href="/kontakt/">Porozmawiajmy o transporcie ↗</a>
      </div>
      <div class="home-hero__tags"><span>TRANSPORT HDS</span><span>KONTENERY I MASZYNY</span><span>MONTAŻ I ROZŁADUNEK</span></div>
    </div>
    <div class="container home-hero__bottom">
      <div class="home-hero__progress" aria-label="Jedno hero"><span class="home-hero__progress-active"></span><small>01 / 01</small></div>
      <a href="/#o-nas" class="home-hero__scroll">ODKRYJ KALTRUCK <span aria-hidden="true">↓</span></a>
      <span class="home-hero__chapter">01 / KALTRUCK STUDIO</span>
    </div>
  </section>

  <div class="ps-home">
    <CapabilityStrip />
    <section class="ps-intro" id="o-nas" aria-labelledby="ps-intro-title">
      <div class="container ps-intro__grid">
        <div class="ps-intro__title">
          <p class="eyebrow">KALTRUCK / KALWASIŃSCY</p>
          <h2 id="ps-intro-title"><span>Transport HDS</span><em>Płock · Polska</em></h2>
        </div>
        <div class="ps-intro__copy">
          <p>Łączymy transport i pracę żurawia HDS w jednej realizacji. Przyjeżdżamy, podnosimy, przewozimy i ustawiamy ładunek tam, gdzie ma finalnie stanąć.</p>
          <div class="ps-intro__flow" aria-label="Zakres realizacji"><span>Transport</span><i></i><span>Podnoszenie</span><i></i><span>Ustawienie</span></div>
        </div>
      </div>
    </section>
    <div id="uslugi" class="ps-service-stories" aria-label="Usługi KALTRUCK">
      <ServiceStory
        eyebrow="01 / KONTENERY"
        title="Kontenery. Od odbioru po precyzyjne ustawienie."
        highlight="Kontenery"
        text="Transport kontenerów mieszkalnych, biurowych i magazynowych z wykorzystaniem HDS — bez organizowania osobnego dźwigu na miejscu."
        href="/uslugi/transport-kontenerow/"
        image="https://hdsplock.pl/zdj/realizacje/transport-kontenerow-07.jpg"
        alt="Transport kontenera samochodem KALTRUCK z żurawiem HDS"
      />
      <ServiceStory
        reverse
        eyebrow="02 / PREFABRYKATY"
        title="Prefabrykaty i konstrukcje bez zbędnych przeładunków."
        highlight="Prefabrykaty"
        text="Elementy betonowe i stalowe przewozimy oraz rozładowujemy jednym zestawem, ograniczając liczbę operacji na placu."
        href="/uslugi/transport-prefabrykatow/"
        image="https://hdsplock.pl/zdj/realizacje/prefabrykaty-betonowe-05.jpg"
        alt="Prefabrykat betonowy podnoszony przez żuraw HDS"
        width={486}
        height={1080}
      />
      <ServiceStory
        eyebrow="03 / MASZYNY"
        title="Maszyny i urządzenia — transport z kontrolą każdego ruchu."
        highlight="Maszyny"
        text="Obsługujemy maszyny, urządzenia techniczne i nietypowe ładunki wymagające podniesienia oraz ustawienia."
        href="/uslugi/transport-maszyn/"
        image="https://hdsplock.pl/zdj/realizacje/suwnice-przemys-owe-04.jpg"
        alt="Realizacja HDS przy ciężkim urządzeniu przemysłowym"
        width={810}
        height={1080}
      />
      <ServiceStory
        reverse
        eyebrow="04 / PRECYZYJNE USTAWIENIE"
        title="Nie tylko dowozimy. Ustawiamy tam, gdzie trzeba."
        highlight="Ustawiamy"
        text="Rozładunek HDS sprawdza się tam, gdzie liczy się zasięg, precyzja i możliwość pracy bez dodatkowego sprzętu dźwigowego."
        href="/uslugi/rozladunek-hds/"
        image="https://hdsplock.pl/zdj/realizacje/stacje-transformatorowe-07.jpg"
        alt="Precyzyjne ustawianie ciężkiego elementu za pomocą HDS"
        width={1435}
        height={1080}
      />
      <ServiceStory
        eyebrow="05 / TRANSPORT SPECJALISTYCZNY"
        title="Nietypowy ładunek nie oznacza przypadkowego planu."
        highlight="Nietypowy"
        text="Realizujemy transport przemysłowy i specjalistyczny w Płocku, na Mazowszu i na terenie całej Polski."
        href="/uslugi/transport-hds/"
        image="https://hdsplock.pl/zdj/realizacje/transport-przemys-owy-03.jpg"
        alt="Specjalistyczny transport przemysłowy KALTRUCK"
        width={1435}
        height={1080}
      />
    </div>
    <EquipmentSection />
    <ProcessSteps />
    <FAQSection />
    <CTASection />
  </div>
</BaseLayout>
